---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from './PostCard.astro';
import { blogIndexHref, formatDate, postHref, postsIn, type BlogPost } from '../../lib/blog';
import '../../styles/blog.css';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const lang = post.lang;
const translationHref = post.translation
  ? postHref({ slug: post.translation, lang: lang === 'en' ? 'fr' : 'en' })
  : undefined;
const related = postsIn(lang).filter((p) => p.slug !== post.slug).slice(0, 3);
const canonicalUrl = new URL(postHref(post), Astro.site).toString();

const copy = {
  en: { home: 'Home', updated: 'Updated', more: 'More from the blog', cta: 'Need cover in Cambodia?', ctaText: 'Tell us about your situation and a broker will get back to you within 24 hours.', ctaBtn: 'Get a free quote' },
  fr: { home: 'Accueil', updated: 'Mis à jour le', more: 'À lire aussi', cta: 'Besoin d’une assurance au Cambodge ?', ctaText: 'Décrivez-nous votre situation et un courtier vous répond sous 24 heures.', ctaBtn: 'Devis gratuit' },
}[lang];

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.date,
  dateModified: post.modified || post.date,
  inLanguage: lang === 'en' ? 'en-US' : 'fr-FR',
  mainEntityOfPage: canonicalUrl,
  url: canonicalUrl,
  ...(post.image ? { image: post.image } : {}),
  author: { '@id': 'https://www.agcambodia.com/#organization' },
  publisher: { '@id': 'https://www.agcambodia.com/#organization' },
};
---

<BaseLayout
  lang={lang}
  title={`${post.title} | AG Cambodia`}
  description={post.description}
  ogImage={post.image ?? undefined}
  ogType="article"
  altHref={translationHref ?? blogIndexHref(lang === 'en' ? 'fr' : 'en')}
  hreflang={Boolean(translationHref)}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.date} />
    {post.modified && <meta property="article:modified_time" content={post.modified} />}
    <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  </Fragment>

  <section class="page-hero post-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={lang === 'en' ? '/' : '/fr/'}>{copy.home}</a>
        <span aria-hidden="true">/</span>
        <a href={blogIndexHref(lang)}>Blog</a>
      </nav>
      {post.categories.length > 0 && <p class="eyebrow eyebrow-light">{post.categories.slice(0, 2).join(' · ')}</p>}
      <h1>{post.title}</h1>
      <p class="post-hero-meta">
        <time datetime={post.date}>{formatDate(post.date, lang)}</time>
        {post.modified && post.modified > post.date && (
          <span> · {copy.updated} <time datetime={post.modified}>{formatDate(post.modified, lang)}</time></span>
        )}
      </p>
    </div>
  </section>

  <section class="section post-section">
    <div class="container post-layout">
      {post.image && (
        <img class="post-feature" src={post.image} alt={post.imageAlt ?? ''} decoding="async" fetchpriority="high" />
      )}
      <article class="post-body" set:html={post.html} />

      <aside class="post-cta">
        <h2>{copy.cta}</h2>
        <p>{copy.ctaText}</p>
        <a href={lang === 'en' ? '/#contact' : '/fr/#contact'} class="btn btn-gold">{copy.ctaBtn}</a>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section-cream">
      <div class="container">
        <h2 class="post-grid-heading">{copy.more}</h2>
        <div class="post-grid">
          {related.map((p) => <PostCard post={p} lang={lang} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

---
import { useTranslations, type Lang } from '../i18n/ui';
import { getAltLangHref, localizedHome } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Explicit path to this page's translated counterpart, if the
   * default mirrored-slug guess doesn't apply (e.g. not yet built). */
  altHref?: string;
  /** Override for the header's "Get a free quote" button, for pages
   * with their own on-page quote form (e.g. "#form" on Claims)
   * instead of the homepage's #contact section. */
  quoteHref?: string;
}

const { lang, altHref, quoteHref } = Astro.props;
const t = useTranslations(lang);
const home = localizedHome(lang);
const resolvedAltHref = altHref ?? getAltLangHref(Astro.url.pathname, lang);

function p(path: string): string {
  return lang === 'en' ? path : '/fr' + path;
}
---

<a class="skip-link" href="#main">{t('skip.toContent')}</a>

<header class="site-header" id="header">
  <div class="container header-inner">
    <a href={home} class="logo">
      <img src="/assets/logo-white.svg" alt="AG Insurance Broker" class="logo-img" />
    </a>

    <nav class="main-nav" id="main-nav" aria-label="Primary">
      <div class="nav-dropdown">
        <button type="button" class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
          {t('nav.generalInsurance')}
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
        </button>
        <div class="nav-dropdown-menu" role="menu">
          <a href={p('/general-insurance-in-cambodia/')} role="menuitem">{t('nav.allCoverages')}</a>
          <a href={p('/property-insurance-in-cambodia/')} role="menuitem">{t('nav.property')}</a>
          <a href={p('/vehicle-insurance-in-cambodia/')} role="menuitem">{t('nav.motor')}</a>
          <a href={p('/public-liability-in-cambodia/')} role="menuitem">{t('nav.publicLiability')}</a>
          <a href={p('/construction-all-risks/')} role="menuitem">{t('nav.construction')}</a>
          <a href={p('/marine-and-cargo-insurance-in-cambodia/')} role="menuitem">{t('nav.marine')}</a>
        </div>
      </div>
      <div class="nav-dropdown">
        <button type="button" class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
          {t('nav.healthInsurance')}
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
        </button>
        <div class="nav-dropdown-menu" role="menu">
          <a href={p('/health-insurance-cambodia/')} role="menuitem">{t('nav.allHealthCoverages')}</a>
          <a href={p('/health-insurance-cambodia/long-term-insurance-cambodia-for-expats/')} role="menuitem">{t('nav.longTerm')}</a>
          <a href={p('/health-insurance-cambodia/employee-staff-insurance/')} role="menuitem">{t('nav.employeeGroup')}</a>
          <a href={p('/health-insurance-cambodia/travel-insurance-cambodia/')} role="menuitem">{t('nav.travel')}</a>
        </div>
      </div>
      <a href={p('/how-to-fill-an-insurance-claim-in-cambodia/')}>{t('nav.claims')}</a>
      <a href={p('/about-us-ag-cambodia-since-2006/')}>{t('nav.aboutUs')}</a>
      <a href={p('/blogs/')}>{t('nav.blog')}</a>
      <a href={p('/where-is-ag-cambodia-in-phnom-penh/')}>{t('nav.contact')}</a>
    </nav>

    <div class="header-actions">
      <a href={resolvedAltHref} class="lang-switch" hreflang={lang === 'en' ? 'fr' : 'en'}>
        {lang === 'en' ? 'FR' : 'EN'}
      </a>
      <button class="nav-toggle" id="nav-toggle" aria-label={t('nav.toggleMenu')} aria-expanded="false" aria-controls="main-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

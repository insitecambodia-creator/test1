---
import { useTranslations, type Lang } from '../i18n/ui';
import { localizedHome } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localizedHome(lang);

function p(path: string): string {
  return lang === 'en' ? path : '/fr' + path;
}
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={home} class="logo logo-footer">
        <img src="/assets/logo-white.svg" alt="AG Insurance Broker" class="logo-img" />
      </a>
      <p>{t('footer.tagline')}</p>
      <div class="social-row">
        <a href="https://www.facebook.com/insurancecambodia" target="_blank" rel="noopener" aria-label="Facebook"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H9v3h2v7h3v-7h3l1-3h-4v-2c0-.6.4-1 1-1Z" fill="currentColor"></path></svg></a>
        <a href="https://t.me/AGCambodia" target="_blank" rel="noopener" aria-label="Telegram"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M21 4 3 11l6 2m12-9-4 16-8-6m0 0 3-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
        <a href="https://www.linkedin.com/company/ag-cambodia-broker" target="_blank" rel="noopener" aria-label="LinkedIn"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"></rect><path d="M7 10v7M7 7v.01M11 17v-4.5c0-1.4 1-2.5 2.5-2.5S16 11.1 16 12.5V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg></a>
      </div>
    </div>

    <nav class="footer-col" aria-label={t('footer.generalInsurance')}>
      <h3>{t('footer.generalInsurance')}</h3>
      <ul>
        <li><a href={p('/property-insurance-in-cambodia/')}>{t('nav.property')}</a></li>
        <li><a href={p('/vehicle-insurance-in-cambodia/')}>{t('nav.motor')}</a></li>
        <li><a href={p('/public-liability-in-cambodia/')}>{t('nav.publicLiability')}</a></li>
        <li><a href={p('/construction-all-risks/')}>{t('nav.construction')}</a></li>
        <li><a href={p('/marine-and-cargo-insurance-in-cambodia/')}>{t('nav.marine')}</a></li>
      </ul>
    </nav>

    <nav class="footer-col" aria-label={t('footer.healthInsurance')}>
      <h3>{t('footer.healthInsurance')}</h3>
      <ul>
        <li><a href={p('/health-insurance-cambodia/long-term-insurance-cambodia-for-expats/')}>{t('footer.individualHealth')}</a></li>
        <li><a href={p('/health-insurance-cambodia/employee-staff-insurance/')}>{t('footer.groupHealth')}</a></li>
        <li><a href={p('/health-insurance-cambodia/long-term-insurance-cambodia-for-expats/')}>{t('footer.internationalHealth')}</a></li>
        <li><a href={p('/health-insurance-cambodia/travel-insurance-cambodia/')}>{t('nav.travel')}</a></li>
      </ul>
    </nav>

    <div class="footer-col footer-contact">
      <h3>{t('footer.contactUs')}</h3>
      <ul>
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11Z" stroke="currentColor" stroke-width="1.5"></path><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.5"></circle></svg>
          <span>{t('footer.address')}</span>
        </li>
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3.5c0-.6.4-1 1-1H7.7c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path></svg>
          <a href="tel:+85523998018">+855 23 998 018</a>
        </li>
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"></rect><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.5"></path></svg>
          <a href="mailto:info@agcambodia.com">info@agcambodia.com</a>
        </li>
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"></circle><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
          <span>{t('footer.hours')}</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>&copy; <span id="year"></span> {t('footer.rights')}</p>
      <div class="footer-legal">
        <a href="#">{t('footer.privacy')}</a>
        <a href="#">{t('footer.terms')}</a>
      </div>
    </div>
  </div>
</footer>

---
/**
 * "Our role as your broker" block: four short steps (study, compare,
 * select, you choose) with wording tailored to each service page.
 * Copy lives in src/data/broker-role.ts.
 */
import type { Lang } from '../i18n/ui';
import { brokerCopy, brokerShared, type BrokerRoleKey } from '../data/broker-role';

interface Props {
  page: BrokerRoleKey;
  lang: Lang;
  /** Cream background, to alternate with the section above. */
  cream?: boolean;
}

const { page, lang, cream = false } = Astro.props;
const shared = brokerShared[lang];
const copy = brokerCopy[page][lang];
const headingId = `broker-role-${page}`;
---

<section class:list={['section', 'broker-role', { 'section-cream': cream }]} aria-labelledby={headingId}>
  <div class="container">
    <p class="eyebrow">{shared.eyebrow}</p>
    <h2 id={headingId}>{copy.heading}</h2>
    <p class="section-lead">{shared.lead}</p>

    <ol class="steps steps-4">
      {copy.steps.map((text, i) => (
        <li class="step">
          <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{shared.titles[i]}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BrokerRole from '../../../components/BrokerRole.astro';
---

<BaseLayout
  lang="fr"
  title="Assurance Marchandises Transportées Cambodge | AG Cambodia"
  description="L'assurance maritime couvre la perte ou les dommages aux navires, marchandises et terminaux lors des transports vers, depuis et au sein du Cambodge."
  quoteHref="#form"
>
  <!-- Page hero -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-grid">
        <div class="page-hero-copy">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/fr/">Accueil</a>
            <span aria-hidden="true">/</span>
            <a href="/fr/general-insurance-in-cambodia/">Assurance Générale</a>
            <span aria-hidden="true">/</span>
            <span>Cargo Maritime</span>
          </nav>
          <p class="eyebrow eyebrow-light">Assurance Générale</p>
          <h1>Assurance Cargo Maritime au Cambodge</h1>
          <p class="hero-lead">L'assurance maritime couvre la perte ou les dommages aux navires, aux marchandises, aux terminaux, et à tout moyen de transport par lequel des biens sont transférés, acquis ou détenus entre le point d'origine et la destination finale.</p>
          <div class="hero-ctas">
            <a href="#form" class="btn btn-gold">Obtenir un devis</a>
            <a href="tel:+85523998018" class="btn btn-outline-light">Appelez-nous</a>
          </div>
        </div>
        <div class="page-hero-visual">
          <img src="/assets/cargo-marine-insurance.webp" alt="Capitaine de navire surveillant un port à conteneurs" width="600" height="400" />
        </div>
      </div>
    </div>
  </section>

  <!-- Article -->
  <section class="section">
    <div class="container">
      <div class="article-grid">
        <div class="article-copy">
          <p class="eyebrow">Assurance Cargo Maritime</p>
          <h2>Une protection de l'origine à la destination</h2>
          <p>L'assurance maritime couvre la perte ou les dommages aux navires, aux marchandises, aux terminaux, et à tout moyen de transport ou de cargaison par lequel des biens sont transférés, acquis ou détenus entre le point d'origine et la destination finale.</p>
          <p>L'assurance cargo est une branche de l'assurance maritime, laquelle inclut également les biens exposés à terre et en mer (terminaux à conteneurs, ports, plateformes pétrolières, pipelines), l'assurance corps de navire, l'assurance accidents maritimes et la responsabilité civile maritime.</p>
          <a href="#form" class="btn btn-gold">Obtenir un devis</a>
        </div>

        <aside class="peril-card">
          <h3>Ce qu'inclut l'assurance maritime</h3>
          <ul class="peril-list">
            <li>Assurance Cargo</li>
            <li>Assurance Corps de Navire</li>
            <li>Accidents Maritimes</li>
            <li>Responsabilité Civile Maritime</li>
            <li>Biens à Terre &amp; en Mer</li>
          </ul>
        </aside>
      </div>

      <div class="notice-box">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"></circle><path d="M12 8v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path><circle cx="12" cy="16" r="0.9" fill="currentColor"></circle></svg>
        <p><strong>Envoi par courrier ou messagerie ?</strong> Lorsque des marchandises sont transportées par courrier ou messagerie, c'est l'assurance colis qui s'applique, et non l'assurance cargo maritime.</p>
      </div>
    </div>
  </section>

  <!-- Who needs it -->
  <section class="section section-cream">
    <div class="container">
      <p class="eyebrow">Qui en a besoin</p>
      <h2>Une protection pour chaque maillon de la chaîne</h2>
      <p class="section-lead">Du port à l'entrepôt, l'assurance cargo maritime protège la valeur des marchandises en transit.</p>

      <div class="cov-grid">
        <article class="cov-card">
          <span class="cov-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M3 17c2 1.4 4.2 1.4 6 0 1.8 1.4 4.2 1.4 6 0 1.8 1.4 4.2 1.4 6 0M5 17V9l4-3h4l4 3v2M9 6v3M15 6v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
          <span class="cov-tag">Commerce</span>
          <h3>Importateurs &amp; Exportateurs</h3>
          <p>Protégez vos marchandises en transit entre l'origine et la destination, par mer, air ou voie terrestre.</p>
          <a href="#form" class="link-arrow">Obtenir un devis <span aria-hidden="true">→</span></a>
        </article>
        <article class="cov-card">
          <span class="cov-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M3 21h18M5 21V10l4-2v13M13 21V6l4-2v17M9 13h0M9 17h0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
          <span class="cov-tag">Logistique</span>
          <h3>Fret &amp; Logistique</h3>
          <p>Couverture des marchandises circulant dans votre chaîne logistique, de l'entrepôt à la livraison finale.</p>
          <a href="#form" class="link-arrow">Obtenir un devis <span aria-hidden="true">→</span></a>
        </article>
        <article class="cov-card">
          <span class="cov-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 21V8l8-5 8 5v13M9 21v-6h6v6M4 21h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
          <span class="cov-tag">Maritime</span>
          <h3>Exploitants de Navires &amp; Terminaux</h3>
          <p>Couverture corps de navire, accidents et responsabilité civile pour les navires, terminaux à conteneurs et infrastructures portuaires.</p>
          <a href="#form" class="link-arrow">Obtenir un devis <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </div>
  </section>

  <!-- Our role as your broker -->
  <BrokerRole page="marine" lang="fr" />

  <!-- Contact / Quote -->
  <section class="section quote-section" id="form">
    <div class="container quote-grid">
      <div class="quote-copy">
        <p class="eyebrow eyebrow-light">Obtenir un devis</p>
        <h2>Votre devis cargo maritime gratuit sous 24 heures</h2>
        <p class="section-lead section-lead-light">Parlez-nous de votre expédition ou de votre flotte. Comparez les offres de plusieurs assureurs grâce à des conseils clairs et professionnels.</p>
        <ul class="check-list check-list-light">
          <li>Nous comparons plus de 15 assureurs pour vous obtenir le meilleur tarif</li>
          <li>Disponible en français et en anglais</li>
          <li>Officiellement agréé et enregistré au Cambodge</li>
          <li>Entièrement confidentiel — votre demande n'est jamais transmise à des tiers</li>
        </ul>
        <div class="quote-cta-row">
          <a href="https://t.me/AGCambodia" class="btn btn-outline-light" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M21 4 3 11l6 2m12-9-4 16-8-6m0 0 3-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            Telegram
          </a>
          <a href="tel:+85523998018" class="btn btn-outline-light">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3.5c0-.6.4-1 1-1H7.7c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
            Appelez-nous
          </a>
        </div>
      </div>

      <div class="quote-form-card">
        <p class="quote-form-title">Faites assurer votre entreprise</p>
        <p class="quote-form-sub">Parlez-nous un peu de votre expédition, un courtier vous rappellera sous 24 heures.</p>

        <div class="quote-tabs" role="tablist" aria-label="Insurance type">
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Assurance Santé</button>
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Véhicule</button>
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Habitation</button>
          <button type="button" class="quote-tab is-active" role="tab" aria-selected="true">Autre</button>
        </div>

        <form id="quote-form" novalidate>
          <div class="form-row">
            <div class="form-field">
              <label for="firstName">Prénom *</label>
              <input id="firstName" name="firstName" type="text" required autocomplete="given-name" />
            </div>
            <div class="form-field">
              <label for="lastName">Nom *</label>
              <input id="lastName" name="lastName" type="text" required autocomplete="family-name" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-field">
              <label for="email">Email *</label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="form-field">
              <label for="phone">Téléphone / WhatsApp *</label>
              <input id="phone" name="phone" type="tel" required autocomplete="tel" />
            </div>
          </div>
          <div class="form-field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="4"></textarea>
          </div>
          <button type="submit" class="btn btn-gold btn-block">Demander mon devis gratuit <span aria-hidden="true">→</span></button>
          <p class="form-note">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="5" y="11" width="14" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4" stroke="currentColor" stroke-width="1.5"></path></svg>
            Vos informations sont 100 % confidentielles
          </p>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

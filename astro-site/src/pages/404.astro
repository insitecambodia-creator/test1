---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en"
  title="Page not found | AG Cambodia"
  description="The page you're looking for doesn't exist. Head back to the AG Cambodia homepage."
>
  <section class="section">
    <div class="container" style="text-align:center; padding: 60px 0;">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="section-lead" style="margin: 0 auto 32px;">Sorry, we couldn't find the page you were looking for. It may have moved, or the link may be out of date.</p>
      <a href="/" class="btn btn-gold">Back to homepage</a>
    </div>
  </section>
</BaseLayout>

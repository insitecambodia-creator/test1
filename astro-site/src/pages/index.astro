---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en"
  title="Insurance Broker in Cambodia since 2006 | AG Cambodia"
  description="Independent insurance broker in Phnom Penh since 2006. Compare health, vehicle, property and business insurance from local and international insurers."
>
  <!-- Hero -->
  <div class="hero-screen" id="top">
  <section class="hero">
    <img class="hero-bg-photo" src="/assets/hero-aug-2.webp" alt="" aria-hidden="true" />
    <div class="hero-bg-scrim" aria-hidden="true"></div>
    <div class="hero-skyline" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow eyebrow-light">Insurance broker in Cambodia</p>
        <h1>Your Trusted<br />
          Insurance Broker<br />
          Since 2006</h1>
        <p class="hero-lead">For 20 years, AG Cambodia has been delivering tailored insurance solutions to individuals and businesses across the Kingdom, combining local expertise, independent advice and a trusted network of insurance partners.</p>
        <div class="hero-ctas">
          <a href="#contact" class="btn btn-gold">Get a free quote</a>
        </div>
      </div>
    </div>
  </section>


  <!-- Stats -->
  <section class="stats-bar">
    <div class="container stats-grid">
      <div class="stat"><svg class="stat-icon" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="4"/><path d="M12 2.5l1.6 1.2 2-.2.7 1.9 1.8.9-.2 2 1.2 1.6-1.2 1.6.2 2-1.8.9-.7 1.9-2-.2L12 15.5l-1.6 1.2-2 .2-.7-1.9-1.8-.9.2-2L4.9 10.5 6.1 8.9l-.2-2 1.8-.9.7-1.9 2 .2z"/><path d="M8.5 15.8 6.5 21.5l2.6-1.1 1.3 2.1 1.6-4.5M15.5 15.8l2 5.7-2.6-1.1-1.3 2.1-1.6-4.5"/></svg><div class="stat-text"><span class="stat-num">20<sup>+</sup></span><span class="stat-label">Years Experience</span></div></div>
      <div class="stat"><svg class="stat-icon" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3"/><circle cx="5.5" cy="10" r="2.2"/><circle cx="18.5" cy="10" r="2.2"/><path d="M6.5 19.5v-1a5.5 5.5 0 0 1 11 0v1z"/><path d="M5.2 14.6A3.8 3.8 0 0 0 1.5 18.4v1.1h5M18.8 14.6a3.8 3.8 0 0 1 3.7 3.8v1.1h-5"/></svg><div class="stat-text"><span class="stat-num">3000</span><span class="stat-label">Clients Protected</span></div></div>
      <div class="stat"><svg class="stat-icon" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5 4.5 5.5v6c0 4.7 3.2 8.6 7.5 10 4.3-1.4 7.5-5.3 7.5-10v-6z"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg><div class="stat-text"><span class="stat-num">15<sup>+</sup></span><span class="stat-label">Insurer Partners</span></div></div>
      <div class="stat"><svg class="stat-icon" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="2.5" y="13" width="4" height="6" rx="1.5"/><rect x="17.5" y="13" width="4" height="6" rx="1.5"/><path d="M19.5 19v.5a2.5 2.5 0 0 1-2.5 2.5h-3.5"/><rect x="10.5" y="21" width="3" height="1.8" rx=".9"/></svg><div class="stat-text"><span class="stat-num">7/7</span><span class="stat-label">Claims Support</span></div></div>
    </div>
  </section>
  </div>


  <!-- Coverages -->
  <section class="section section-cream" id="coverages">
    <div class="container">
      <p class="eyebrow">All coverages</p>
      <h2>Every risk, <span class="text-gold-ink">one broker</span></h2>
      <p class="section-lead">From a motorbike in Phnom Penh to a construction site in Sihanoukville — we cover it all with the right level of expertise.</p>

      <div class="coverage-group">
        <span class="tag tag-gold">For Individuals</span>
        <p class="coverage-group-intro">International health insurance, motor, home and travel insurance — tailored to the needs of individuals and families living in Cambodia. Our dedicated local team is here to assist you in Khmer, English and French, whenever you need us.</p>
        <div class="cov-grid">
          <article class="cov-card cov-card-has-image">
            <div class="cov-card-image">
              <img src="/assets/private-health-insurance.webp" alt="Doctor and nurse reviewing patient records on a tablet" width="600" height="400" loading="lazy" />
            </div>
            <span class="cov-tag">Health</span>
            <h3>Health Insurance</h3>
            <p>International &amp; local health cover for individuals, families, and teams.</p>
            <a href="/health-insurance-cambodia/long-term-insurance-cambodia-for-expats/" class="link-arrow">Learn more <span aria-hidden="true">→</span></a>
          </article>
          <article class="cov-card cov-card-has-image">
            <div class="cov-card-image">
              <img src="/assets/vehicle-insurance.webp" alt="Couple with their car on a road trip in the Cambodian countryside" width="600" height="400" loading="lazy" />
            </div>
            <span class="cov-tag">Motor</span>
            <h3>Vehicle Insurance</h3>
            <p>Comprehensive, third-party and fleet cover for cars, trucks and motorbikes.</p>
            <a href="/vehicle-insurance-in-cambodia/" class="link-arrow">Learn more <span aria-hidden="true">→</span></a>
          </article>
          <article class="cov-card cov-card-has-image">
            <div class="cov-card-image">
              <img src="/assets/homeinsurance.webp" alt="Couple relaxing on the sofa in their living room" width="1672" height="941" loading="lazy" />
            </div>
            <span class="cov-tag">Home</span>
            <h3>Home Insurance</h3>
            <p>Cover for your condo or house: contents and theft, public liability and home helper accident cover.</p>
            <a href="/property-insurance-in-cambodia/" class="link-arrow">Learn more <span aria-hidden="true">→</span></a>
          </article>
        </div>
      </div>

      <div class="coverage-group">
        <span class="tag tag-navy">For Businesses</span>
        <p class="coverage-group-intro">Full corporate coverage programs — from employee health &amp; liability, to property, cargo and construction risks for businesses of all sizes operating in Cambodia and the region.</p>
        <div class="cov-grid">
          <article class="cov-card cov-card-has-image">
            <div class="cov-card-image">
              <img src="/assets/employee-benefit.webp" alt="Two colleagues chatting in an office corridor" width="600" height="400" loading="lazy" />
            </div>
            <span class="cov-tag">Health &bull; Contracts</span>
            <h3>Employee Health Plans</h3>
            <p>Group health packages for companies of any size — from 2 to 2,000+ employees.</p>
            <a href="/health-insurance-cambodia/employee-staff-insurance/" class="link-arrow">Learn more <span aria-hidden="true">→</span></a>
          </article>
          <article class="cov-card cov-card-has-image">
            <div class="cov-card-image">
              <img src="/assets/property-insurance.webp" alt="Professional with a tablet reviewing a client site" width="600" height="400" loading="lazy" />
            </div>
            <span class="cov-tag">Professional</span>
            <h3>Professional Indemnity</h3>
            <p>Protection when your professional advice, services or mistakes lead to a client claim.</p>
            <a href="/professional-indemnity/" class="link-arrow">Learn more <span aria-hidden="true">→</span></a>
          </article>
          <article class="cov-card cov-card-has-image">
            <div class="cov-card-image">
              <img src="/assets/property-public-liability.webp" alt="Modern office building representing business property and public liability cover" width="600" height="400" loading="lazy" />
            </div>
            <span class="cov-tag">Property</span>
            <h3>Property &amp; Public Liability</h3>
            <p>Cover for your business property, together with protection against third-party injury and damage claims.</p>
            <a href="/general-insurance-in-cambodia/business-property-insurance-in-cambodia/" class="link-arrow">Learn more <span aria-hidden="true">→</span></a>
          </article>
          <article class="cov-card cov-card-has-image">
            <div class="cov-card-image">
              <img src="/assets/construction-insurance.webp" alt="Engineer with blueprints at a construction site" width="600" height="400" loading="lazy" />
            </div>
            <span class="cov-tag">Construction</span>
            <h3>Contractor's All Risks</h3>
            <p>Every single construction site must have a liability insurance by law.</p>
            <a href="/construction-all-risks/" class="link-arrow">Learn more <span aria-hidden="true">→</span></a>
          </article>
          <article class="cov-card cov-card-has-image">
            <div class="cov-card-image">
              <img src="/assets/fleet-insurance-cambodia.webp" alt="Company vehicle fleet parked outside a Cambodian office" width="600" height="400" loading="lazy" />
            </div>
            <span class="cov-tag">Vehicle</span>
            <h3>Fleet Insurance</h3>
            <p>Mandatory third-party insurance for your fleet of cars, trucks or buses.</p>
            <a href="/general-insurance-in-cambodia/corporate-fleet-insurance/" class="link-arrow">Learn more <span aria-hidden="true">→</span></a>
          </article>
          <article class="cov-card cov-card-cta">
            <h3>Tell us your situation</h3>
            <p>Every situation is different, let us find the best suitable plan for you and your family.</p>
            <a href="#contact" class="btn btn-gold btn-sm">Get a free quote <span aria-hidden="true">→</span></a>
            <a href="https://t.me/AGCambodia" class="btn btn-telegram btn-sm" target="_blank" rel="noopener"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 4 3 11l6 2m12-9-4 16-8-6m0 0 3-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg> Chat on Telegram</a>
          </article>
        </div>
      </div>
    </div>
  </section>


  <!-- Why choose us -->
  <section class="section why-section">
    <div class="container">
      <p class="eyebrow eyebrow-light">It works for you</p>
      <h2>Why choose us?</h2>
      <p class="section-lead section-lead-light why-intro"><em>At AG insurance Broker, we work for you and for the protection of your interests. We analyze your risks, secure the most competitive and suitable solutions on the market, arrange the placement of your policy, and manage your contract while providing assistance for the resolution of all your claims.</em></p>

      <div class="why-grid">
        <div class="why-item">
          <h3>We <span class="text-gold-light">advise</span> adapted coverage to your needs</h3>
          <p>We analyze your needs and recommend a policy suited to your situation, taking into account your risk exposure as it relates directly to your business, your property, your family or your personal needs.</p>
        </div>
        <div class="why-item">
          <h3>We <span class="text-gold-light">compare</span> the market for you</h3>
          <p>We compare offers across a panel of local and international insurers, weighing each one on coverage, insurer strength and price. The lowest premium is not always the best protection; our role is to make these differences clear so you can choose with confidence.</p>
        </div>
        <div class="why-item">
          <h3>We <span class="text-gold-light">manage</span> your policy</h3>
          <p>Insurance should not be forgotten once the policy is issued. We handle amendments, renewals and ongoing discussions with insurers, keeping your policy aligned with how your risks actually change.</p>
        </div>
        <div class="why-item">
          <h3>We <span class="text-gold-light">provide</span> local Claim Support</h3>
          <p>When a claim arises, our local team coordinates the process with the insurer from start to resolution, acting to safeguard your interests throughout. You have a contact who already knows your file, your policy and your situation, rather than dealing with the insurance company alone.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- Partners -->
  <section class="section partners-section">
    <div class="container">
      <h2>We Work With The Best Companies<br />In Cambodia</h2>
      <div class="partners-copy">
        <p>Our exclusive agreements with most major insurance companies in the world and here in Cambodia provide you the finest solutions on the market. We provide tailored coverage to fit exactly your needs and make sure your policy really protects you effectively.</p>
        <p>To enjoy Cambodia to the fullest, you can count on AG CAMBODIA to provide you with a genuine peace of mind.</p>
        <p>Our office is located in the center of Phnom Penh within Himawari Hotel on riverside, regular hours are from Monday to Friday, 9am to 5pm.</p>
      </div>
    </div>
    <div class="partners-marquee" aria-label="Our insurance partners">
      <div class="partners-track">
        <ul class="partners-set">
          <li><img src="/assets/LOGO-insurance-cambodia-dara.jpg" alt="Dara Insurance PLC" loading="lazy" /></li>
          <li><img src="/assets/LOGO-insurance-cambodia-etiqa.jpg" alt="Etiqa General Insurance" loading="lazy" /></li>
          <li><img src="/assets/LOGO-insurance-cambodia-lyhour.jpg" alt="LY HOUR / LHSBI Insurance" loading="lazy" /></li>
          <li><img src="/assets/infinity.jpg" alt="Infinity Insurance" loading="lazy" /></li>
          <li><img src="/assets/people-and-partners.jpg" alt="People & Partners Insurance PLC" loading="lazy" /></li>
          <li><img src="/assets/forte.jpg" alt="Forte Insurance" loading="lazy" /></li>
          <li><img src="/assets/luma-1.webp" alt="Luma" loading="lazy" /></li>
          <li><img src="/assets/LOGO-insurance-cambodia-BKI.jpg" alt="Bangkok Insurance" loading="lazy" /></li>
        </ul>
        <ul class="partners-set" aria-hidden="true">
          <li><img src="/assets/LOGO-insurance-cambodia-dara.jpg" alt="" loading="lazy" /></li>
          <li><img src="/assets/LOGO-insurance-cambodia-etiqa.jpg" alt="" loading="lazy" /></li>
          <li><img src="/assets/LOGO-insurance-cambodia-lyhour.jpg" alt="" loading="lazy" /></li>
          <li><img src="/assets/infinity.jpg" alt="" loading="lazy" /></li>
          <li><img src="/assets/people-and-partners.jpg" alt="" loading="lazy" /></li>
          <li><img src="/assets/forte.jpg" alt="" loading="lazy" /></li>
          <li><img src="/assets/luma-1.webp" alt="" loading="lazy" /></li>
          <li><img src="/assets/LOGO-insurance-cambodia-BKI.jpg" alt="" loading="lazy" /></li>
        </ul>
      </div>
    </div>
  </section>


  <!-- Local team -->
  <section class="section" id="about">
    <div class="container team-grid">
      <div class="team-visual">
        <div class="team-visual-inner">
          <img class="team-photo" src="/assets/team-1.webp" alt="The AG Cambodia team outside their Phnom Penh office" />
        </div>
      </div>
      <div class="team-copy">
        <p class="eyebrow">Our team is in Cambodia</p>
        <h2>We are <span class="text-gold-ink">at your side</span></h2>
        <p class="section-lead">After operating more than 20 years (since 2006) in the Kingdom of Cambodia, we have a very thorough and extensive knowledge about all the risks incurred when living or working here.</p>
        <p class="team-body">As a broker we provide sound professional advice to cover your risks accurately and source from the market the best solution at the best possible rate. Liaising with a broker ensures you have the right cover at the right price and real-time support when you have claims. Should anything happen to you, simply make a local call 24/7 and you will find precious support to handle your situation.</p>
        <a href="/about-us-ag-cambodia-since-2006/" class="btn btn-gold">Meet the team</a>
      </div>
    </div>
  </section>

  <!-- Contact / Quote -->
  <section class="section quote-section" id="contact">
    <div class="container quote-grid">
      <div class="quote-copy">
        <p class="eyebrow eyebrow-light">Get a quote</p>
        <h2>Your free insurance quote</h2>
        <p class="section-lead section-lead-light">Tell us about your business or situation. Compare offers from multiple insurers with clear, professional advice.</p>
        <ul class="check-list check-list-light">
          <li>We compare 15+ insurers to get you the best rate</li>
          <li>Available in French and English</li>
          <li>Officially licensed and registered in Cambodia</li>
          <li>Fully confidential — your request is never spammed</li>
        </ul>
        <div class="quote-cta-row">
          <a href="https://t.me/AGCambodia" class="btn btn-outline-light" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M21 4 3 11l6 2m12-9-4 16-8-6m0 0 3-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            Telegram
          </a>
          <a href="tel:+85523998018" class="btn btn-outline-light">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3.5c0-.6.4-1 1-1H7.7c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
            Call us
          </a>
        </div>
      </div>

      <div class="quote-form-card">
        <p class="quote-form-title">Company &amp; get covered</p>
        <p class="quote-form-sub">Tell us a bit about your needs and a broker will call you back within 24 hours.</p>

        <div class="quote-tabs" role="tablist" aria-label="Insurance type">
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Health Insurance</button>
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Vehicle</button>
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Property</button>
          <button type="button" class="quote-tab is-active" role="tab" aria-selected="true">Other</button>
        </div>

        <form id="quote-form" novalidate>
          <div class="form-row">
            <div class="form-field">
              <label for="firstName">First name *</label>
              <input id="firstName" name="firstName" type="text" required autocomplete="given-name" />
            </div>
            <div class="form-field">
              <label for="lastName">Last name *</label>
              <input id="lastName" name="lastName" type="text" required autocomplete="family-name" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-field">
              <label for="email">Email *</label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="form-field">
              <label for="phone">Phone / WhatsApp *</label>
              <input id="phone" name="phone" type="tel" required autocomplete="tel" />
            </div>
          </div>
          <div class="form-field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="4"></textarea>
          </div>
          <button type="submit" class="btn btn-gold btn-block">Request my free quote <span aria-hidden="true">→</span></button>
          <p class="form-note">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="5" y="11" width="14" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4" stroke="currentColor" stroke-width="1.5"></path></svg>
            Your information is 100% confidential
          </p>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en"
  title="General Insurance in Cambodia | AG Cambodia"
  description="AG Cambodia helps individuals, families, and businesses protect what matters most — vehicles, property, liability, construction, marine cargo and more."
  quoteHref="#contact"
>
  <!-- Page hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>General Insurance</span>
      </nav>
      <p class="eyebrow eyebrow-light">General Insurance</p>
      <h1>General Insurance in Cambodia</h1>
      <p class="hero-lead">At AG Cambodia, we help individuals, families, and businesses protect what matters most. As a licensed insurance broker based in Phnom Penh, our role is to guide clients through the wide range of insurance solutions available in Cambodia and identify the coverage that best fits their needs.</p>
      <div class="hero-ctas">
        <a href="#contact" class="btn btn-gold">Get a Quote</a>
      </div>
    </div>
  </section>

  <!-- What a broker does -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">Why work with a broker</p>
      <h2>On your side, not the insurer's</h2>
      <p class="section-lead">Unlike an insurance company that promotes its own products, a broker works on behalf of the client. We compare policies from some of the most reliable insurers operating in Cambodia in order to find the most appropriate protection at a competitive price. Our team also supports you throughout the life of your policy — from the initial quotation to policy management and claims assistance when needed.</p>
      <p class="section-lead">Insurance needs vary widely depending on your situation, whether you are an individual seeking protection for your vehicle or home, or a business looking to manage operational risks. Our general insurance services in Cambodia cover a broad range of areas designed to protect both personal and professional assets.</p>
    </div>
  </section>

  <!-- Coverage areas -->
  <section class="section section-cream">
    <div class="container">
      <p class="eyebrow">Our coverage areas</p>
      <h2>Protection for every risk</h2>

      <div class="cov-grid">
        <article class="cov-card">
          <span class="cov-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 21V9l8-5 8 5v12M9 21v-6h6v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
          <span class="cov-tag">Vehicles</span>
          <h3>Vehicle Insurance</h3>
          <p>Covers your vehicles up to All Risks insurance, from motorbike to SUV or company fleet.</p>
          <a href="/vehicle-insurance-in-cambodia/" class="link-arrow">Learn more <span aria-hidden="true">→</span></a>
        </article>
        <article class="cov-card">
          <span class="cov-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 21V8l8-5 8 5v13M9 21v-6h6v6M4 21h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
          <span class="cov-tag">Property</span>
          <h3>Property Insurance</h3>
          <p>Insures your home, hotel, offices, or other commercial premises against fire, flood and more.</p>
          <a href="/property-insurance-in-cambodia/" class="link-arrow">Learn more <span aria-hidden="true">→</span></a>
        </article>
        <article class="cov-card">
          <span class="cov-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path><circle cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width="1.6"></circle></svg></span>
          <span class="cov-tag">Liability</span>
          <h3>Public Liability</h3>
          <p>Covers material damage and bodily injury you cause to third parties.</p>
          <a href="/public-liability-in-cambodia/" class="link-arrow">Learn more <span aria-hidden="true">→</span></a>
        </article>
        <article class="cov-card">
          <span class="cov-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M3 21h18M5 21V10l4-2v13M13 21V6l4-2v17M9 13h0M9 17h0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
          <span class="cov-tag">Construction</span>
          <h3>Construction All Risks</h3>
          <p>Covers liability and contract works for construction companies and developers.</p>
          <a href="/construction-all-risks/" class="link-arrow">Learn more <span aria-hidden="true">→</span></a>
        </article>
        <article class="cov-card">
          <span class="cov-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M3 17c2 1.4 4.2 1.4 6 0 1.8 1.4 4.2 1.4 6 0 1.8 1.4 4.2 1.4 6 0M5 17V9l4-3h4l4 3v2M9 6v3M15 6v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
          <span class="cov-tag">Marine Cargo</span>
          <h3>Marine Cargo Insurance</h3>
          <p>For insuring exporting and importing goods in transit, by sea, air or land.</p>
          <a href="/marine-and-cargo-insurance-in-cambodia/" class="link-arrow">Learn more <span aria-hidden="true">→</span></a>
        </article>
        <article class="cov-card">
          <span class="cov-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 12h4l2-5 4 10 2-5h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
          <span class="cov-tag">Corporate</span>
          <h3>Employee Health Plans</h3>
          <p>For your employees' health — group health packages for companies of any size.</p>
          <a href="/health-insurance-cambodia/employee-staff-insurance/" class="link-arrow">Learn more <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </div>
  </section>

  <!-- More corporate coverage -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">More corporate coverage</p>
      <h2>Specialized cover for your business</h2>
      <p class="section-lead">Beyond the essentials, AG Cambodia also arranges specialized corporate coverage for fleets, commercial premises, and professional risk.</p>

      <div class="cov-grid">
        <article class="cov-card">
          <span class="cov-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M3 17c2 1.4 4.2 1.4 6 0 1.8 1.4 4.2 1.4 6 0 1.8 1.4 4.2 1.4 6 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path><path d="M3 12c2 1.4 4.2 1.4 6 0 1.8 1.4 4.2 1.4 6 0 1.8 1.4 4.2 1.4 6 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity="0.5"></path></svg></span>
          <span class="cov-tag">Fleets</span>
          <h3>Corporate Fleet Insurance</h3>
          <p>Motor cover for companies operating cars, vans, trucks or other vehicles.</p>
          <a href="/general-insurance-in-cambodia/corporate-fleet-insurance/" class="link-arrow">Learn more <span aria-hidden="true">→</span></a>
        </article>
        <article class="cov-card">
          <span class="cov-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="4" y="3" width="16" height="18" rx="1.5" stroke="currentColor" stroke-width="1.6"></rect><path d="M8 8h2M8 12h2M8 16h2M14 8h2M14 12h2M14 16h2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg></span>
          <span class="cov-tag">Commercial Premises</span>
          <h3>Business Property Insurance</h3>
          <p>Protects offices, shops, restaurants, hotels, warehouses and factories from physical loss or damage.</p>
          <a href="/general-insurance-in-cambodia/business-property-insurance-in-cambodia/" class="link-arrow">Learn more <span aria-hidden="true">→</span></a>
        </article>
        <article class="cov-card">
          <span class="cov-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 4h16v12H9l-5 4V4Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path><path d="M8 9h8M8 12h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg></span>
          <span class="cov-tag">Professional Risk</span>
          <h3>Professional Indemnity</h3>
          <p>Protects consultants, architects, engineers and agencies against claims of professional negligence.</p>
          <a href="/professional-indemnity/" class="link-arrow">Learn more <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </div>
  </section>

  <!-- Contact / Quote -->
  <section class="section quote-section" id="contact">
    <div class="container quote-grid">
      <div class="quote-copy">
        <p class="eyebrow eyebrow-light">Get a quote</p>
        <h2>Your free quote within 24 hours</h2>
        <p class="section-lead section-lead-light">Tell us about your business or situation. Compare offers from multiple insurers with clear, professional advice.</p>
        <ul class="check-list check-list-light">
          <li>We compare 15+ insurers to get you the best rate</li>
          <li>Available in French and English</li>
          <li>Officially licensed and registered in Cambodia</li>
          <li>Fully confidential — your request is never spammed</li>
        </ul>
        <div class="quote-cta-row">
          <a href="https://t.me/AGCambodia" class="btn btn-outline-light" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M21 4 3 11l6 2m12-9-4 16-8-6m0 0 3-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            Telegram
          </a>
          <a href="tel:+85523998018" class="btn btn-outline-light">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3.5c0-.6.4-1 1-1H7.7c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
            Call us
          </a>
        </div>
      </div>

      <div class="quote-form-card">
        <p class="quote-form-title">Company &amp; get covered</p>
        <p class="quote-form-sub">Tell us a bit about your needs and a broker will call you back within 24 hours.</p>

        <div class="quote-tabs" role="tablist" aria-label="Insurance type">
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Health Insurance</button>
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Vehicle</button>
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Property</button>
          <button type="button" class="quote-tab is-active" role="tab" aria-selected="true">Other</button>
        </div>

        <form id="quote-form" novalidate>
          <div class="form-row">
            <div class="form-field">
              <label for="firstName">First name *</label>
              <input id="firstName" name="firstName" type="text" required autocomplete="given-name" />
            </div>
            <div class="form-field">
              <label for="lastName">Last name *</label>
              <input id="lastName" name="lastName" type="text" required autocomplete="family-name" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-field">
              <label for="email">Email *</label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="form-field">
              <label for="phone">Phone / WhatsApp *</label>
              <input id="phone" name="phone" type="tel" required autocomplete="tel" />
            </div>
          </div>
          <div class="form-field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="4"></textarea>
          </div>
          <button type="submit" class="btn btn-gold btn-block">Request my free quote <span aria-hidden="true">→</span></button>
          <p class="form-note">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="5" y="11" width="14" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4" stroke="currentColor" stroke-width="1.5"></path></svg>
            Your information is 100% confidential
          </p>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en"
  title="Contact AG Cambodia, Insurance Broker in Phnom Penh"
  description="Visit AG Cambodia's office on Sisowath Quay in Phnom Penh, call our team directly, or send us a message — we're on hand Monday to Friday."
  quoteHref="#contact"
>
  <!-- Page hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>Contact</span>
      </nav>
      <p class="eyebrow eyebrow-light">Get in touch</p>
      <h1>Contact Us</h1>
      <p class="hero-lead">Visit our office in Phnom Penh, call our team directly, or send us a message below — we're on hand Monday to Friday, and our claims line never closes.</p>
      <div class="hero-ctas">
        <a href="tel:+85523998018" class="btn btn-gold">Call us now</a>
        <a href="https://t.me/AGCambodia" class="btn btn-outline-light" target="_blank" rel="noopener">Message us on Telegram</a>
      </div>
    </div>
  </section>

  <!-- Contact details -->
  <section class="section">
    <div class="container">
      <div class="cov-grid">
        <article class="cov-card">
          <span class="cov-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11Z" stroke="currentColor" stroke-width="1.6"></path><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.6"></circle></svg></span>
          <h3>Office Location</h3>
          <p>313 Sisowath Quay, Phnom Penh 12300 — inside the Himawari Compound.</p>
        </article>
        <article class="cov-card">
          <span class="cov-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"></circle><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg></span>
          <h3>Operation Hours</h3>
          <p>9:00 AM to 5:00 PM, Monday through Friday. Claims support available 24/7.</p>
        </article>
        <article class="cov-card">
          <span class="cov-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3.5c0-.6.4-1 1-1H7.7c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg></span>
          <h3>Landline Number</h3>
          <p><a href="tel:+85523998018">+855 23 998 018</a></p>
        </article>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="section section-cream">
    <div class="container">
      <p class="eyebrow">Find us</p>
      <h2>On Sisowath Quay, Phnom Penh</h2>
      <div class="map-embed">
        <iframe
          src="https://www.google.com/maps?q=AG+Insurance+Broker+Cambodia,+Sisowath+Quay,+Phnom+Penh&z=15&output=embed"
          width="100%"
          height="420"
          style="border:0"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="AG Cambodia office location on Sisowath Quay, Phnom Penh"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Contact / Quote -->
  <section class="section quote-section" id="contact">
    <div class="container quote-grid">
      <div class="quote-copy">
        <p class="eyebrow eyebrow-light">Get a quote</p>
        <h2>Your free quote within 24 hours</h2>
        <p class="section-lead section-lead-light">Tell us about your business or situation. Compare offers from multiple insurers with clear, professional advice.</p>
        <ul class="check-list check-list-light">
          <li>We compare 15+ insurers to get you the best rate</li>
          <li>Available in French and English</li>
          <li>Officially licensed and registered in Cambodia</li>
          <li>Fully confidential — your request is never spammed</li>
        </ul>
        <div class="quote-cta-row">
          <a href="https://t.me/AGCambodia" class="btn btn-outline-light" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M21 4 3 11l6 2m12-9-4 16-8-6m0 0 3-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            Telegram
          </a>
          <a href="tel:+85523998018" class="btn btn-outline-light">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3.5c0-.6.4-1 1-1H7.7c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
            Call us
          </a>
        </div>
      </div>

      <div class="quote-form-card">
        <p class="quote-form-title">Company &amp; get covered</p>
        <p class="quote-form-sub">Tell us a bit about your needs and a broker will call you back within 24 hours.</p>

        <div class="quote-tabs" role="tablist" aria-label="Insurance type">
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Health Insurance</button>
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Vehicle</button>
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Property</button>
          <button type="button" class="quote-tab is-active" role="tab" aria-selected="true">Other</button>
        </div>

        <form id="quote-form" novalidate>
          <div class="form-row">
            <div class="form-field">
              <label for="firstName">First name *</label>
              <input id="firstName" name="firstName" type="text" required autocomplete="given-name" />
            </div>
            <div class="form-field">
              <label for="lastName">Last name *</label>
              <input id="lastName" name="lastName" type="text" required autocomplete="family-name" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-field">
              <label for="email">Email *</label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="form-field">
              <label for="phone">Phone / WhatsApp *</label>
              <input id="phone" name="phone" type="tel" required autocomplete="tel" />
            </div>
          </div>
          <div class="form-field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="4"></textarea>
          </div>
          <button type="submit" class="btn btn-gold btn-block">Request my free quote <span aria-hidden="true">→</span></button>
          <p class="form-note">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="5" y="11" width="14" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4" stroke="currentColor" stroke-width="1.5"></path></svg>
            Your information is 100% confidential
          </p>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

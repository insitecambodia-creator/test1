---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en"
  title="Car & Motorbike Insurance in Cambodia | AG Cambodia"
  description="Road accidents are frequent in Cambodia. Get car or motorbike insurance, from compulsory third-party liability to comprehensive cover, with AG Cambodia."
  quoteHref="#form"
>
  <!-- Page hero -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-grid">
        <div class="page-hero-copy">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <a href="/general-insurance-in-cambodia/">General Insurance</a>
            <span aria-hidden="true">/</span>
            <span>Vehicle Insurance</span>
          </nav>
          <p class="eyebrow eyebrow-light">Private Insurance – Motor Vehicle Coverage</p>
          <h1>Vehicle Insurance</h1>
          <p class="hero-lead">Driving in Cambodia comes with everyday risks, from minor accidents and vehicle damage to more serious collisions involving passengers or third parties. Private Vehicle Insurance can protect your car or scooter against accidental damage, theft and liability for injury or damage caused to others.</p>
          <div class="hero-ctas">
            <a href="#form" class="btn btn-gold">Get a Quote</a>
            <a href="tel:+85523998018" class="btn btn-outline-light">Call us</a>
          </div>
        </div>
        <div class="page-hero-visual">
          <img src="/assets/vehicle-insurance.webp" alt="Couple with their car on a road trip in the Cambodian countryside" width="600" height="400" />
        </div>
      </div>
    </div>
  </section>

  <!-- Article -->
  <section class="section">
    <div class="container article-grid">
      <div class="article-copy">
        <p class="eyebrow">Vehicle Insurance</p>
        <h2>Cover for every driving risk</h2>
        <p>Depending on the level of cover selected, policies can include third-party liability, passenger liability and All Risks protection for your own vehicle. AG Cambodia can help you compare the available options and choose cover suited to your vehicle, how you use it and the level of protection you want.</p>
        <p>Our expertise lies in understanding the specific characteristics, usage and risk exposures associated with your vehicle. Through a comprehensive assessment of your insurance needs, we provide independent professional advice and recommend coverage tailored to your actual exposure and protection requirements.</p>
        <a href="#form" class="btn btn-gold">Get a Quote</a>
      </div>

      <aside class="peril-card">
        <h3>Why get covered</h3>
        <ul class="peril-list">
          <li>24/7 claim assistance</li>
          <li>Insurer liaises with Police &amp; Third Party</li>
          <li>Own vehicle damage cover</li>
          <li>Theft protection</li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- Coverage tiers -->
  <section class="section section-cream">
    <div class="container">
      <p class="eyebrow">Choose your cover</p>
      <h2>Three levels of protection</h2>
      <p class="section-lead">From basic third-party cover to our exclusive extended liability guarantee — pick the level of protection that matches your vehicle and your risk.</p>

      <div class="cov-grid">
        <article class="cov-card">
          <span class="cov-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 21V9l8-5 8 5v12M9 21v-6h6v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
          <span class="cov-tag">Own Damage &bull; Theft</span>
          <h3>All Risks</h3>
          <p>With All Risks insurance you are covered for damage to your own vehicle, including theft, to compensate the loss value of your vehicle.</p>
          <a href="#form" class="link-arrow">Get a Quote <span aria-hidden="true">→</span></a>
        </article>
        <article class="cov-card">
          <span class="cov-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="9" cy="7" r="3" stroke="currentColor" stroke-width="1.6"></circle><circle cx="17" cy="10" r="2.4" stroke="currentColor" stroke-width="1.6"></circle><path d="M3.5 20c.8-3.4 3-5.2 5.5-5.2s4.4 1.5 5.3 4M14.5 20c.5-2.4 2-3.7 3.9-3.7 1.4 0 2.6.7 3.4 1.9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg></span>
          <span class="cov-tag">Passenger Liability</span>
          <h3>Third Party Liability</h3>
          <p>This benefit includes Passenger Liability to cover passengers in your car in case of death or injury.</p>
          <a href="#form" class="link-arrow">Get a Quote <span aria-hidden="true">→</span></a>
        </article>
        <article class="cov-card">
          <span class="cov-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 2 3 6v6c0 5 3.8 8.7 9 10 5.2-1.3 9-5 9-10V6l-9-4Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path><path d="m8.5 12 2.3 2.3L15.8 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
          <span class="cov-tag">Exclusive to AG Cambodia</span>
          <h3>First Class Third Party Liability</h3>
          <p>Available exclusively at AG Cambodia! Our exclusive extended Third Party Liability guarantee covers third-party body injury up to $100,000 per person or vehicle, and up to $500,000 per accident.</p>
          <a href="#form" class="link-arrow">Get a Quote <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </div>
  </section>

  <!-- Contact / Quote -->
  <section class="section quote-section" id="form">
    <div class="container quote-grid">
      <div class="quote-copy">
        <p class="eyebrow eyebrow-light">Get a quote</p>
        <h2>Your free vehicle insurance quote</h2>
        <p class="section-lead section-lead-light">Tell us about your vehicle. Compare offers from multiple insurers with clear, professional advice.</p>
        <ul class="check-list check-list-light">
          <li>We compare 15+ insurers to get you the best rate</li>
          <li>Available in French and English</li>
          <li>Officially licensed and registered in Cambodia</li>
          <li>Fully confidential — your request is never spammed</li>
        </ul>
        <div class="quote-cta-row">
          <a href="https://t.me/AGCambodia" class="btn btn-outline-light" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M21 4 3 11l6 2m12-9-4 16-8-6m0 0 3-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            Telegram
          </a>
          <a href="tel:+85523998018" class="btn btn-outline-light">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3.5c0-.6.4-1 1-1H7.7c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
            Call us
          </a>
        </div>
      </div>

      <div class="quote-form-card">
        <p class="quote-form-title">Company &amp; get covered</p>
        <p class="quote-form-sub">Tell us a bit about your vehicle and a broker will call you back within 24 hours.</p>

        <div class="quote-tabs" role="tablist" aria-label="Insurance type">
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Health Insurance</button>
          <button type="button" class="quote-tab is-active" role="tab" aria-selected="true">Vehicle</button>
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Property</button>
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Other</button>
        </div>

        <form id="quote-form" novalidate>
          <div class="form-row">
            <div class="form-field">
              <label for="firstName">First name *</label>
              <input id="firstName" name="firstName" type="text" required autocomplete="given-name" />
            </div>
            <div class="form-field">
              <label for="lastName">Last name *</label>
              <input id="lastName" name="lastName" type="text" required autocomplete="family-name" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-field">
              <label for="email">Email *</label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="form-field">
              <label for="phone">Phone / WhatsApp *</label>
              <input id="phone" name="phone" type="tel" required autocomplete="tel" />
            </div>
          </div>
          <div class="form-field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="4"></textarea>
          </div>
          <button type="submit" class="btn btn-gold btn-block">Request my free quote <span aria-hidden="true">→</span></button>
          <p class="form-note">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="5" y="11" width="14" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4" stroke="currentColor" stroke-width="1.5"></path></svg>
            Your information is 100% confidential
          </p>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

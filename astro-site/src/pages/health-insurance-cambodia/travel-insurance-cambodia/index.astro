---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en"
  title="Travel Insurance for Cambodia | AG Cambodia"
  description="Planning a trip to the Kingdom of Cambodia? We cover holiday getaways and business trips with solid insurance policies."
  quoteHref="#form"
>
  <!-- Page hero -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-grid">
        <div class="page-hero-copy">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <a href="/health-insurance-cambodia/">Health Insurance</a>
            <span aria-hidden="true">/</span>
            <span>Travel Insurance</span>
          </nav>
          <p class="eyebrow eyebrow-light">Health Insurance – Private Insurance</p>
          <h1>Travel Insurance</h1>
          <p class="hero-lead">A short business trip or a family holiday can turn into an expensive problem without the right cover in place. Travel insurance protects against emergency medical care and evacuation abroad, trip cancellation and interruption, and baggage delay or loss, for single trips or on an annual multi-trip basis.</p>
          <div class="hero-ctas">
            <a href="#form" class="btn btn-gold">Get a free quote</a>
            <a href="#coverage" class="btn btn-outline-light">What's covered</a>
          </div>
        </div>
        <div class="page-hero-visual">
          <img src="/assets/travel-insurance.webp" alt="Couple smiling with boarding passes at the airport" width="600" height="400" />
        </div>
      </div>
    </div>
  </section>

  <!-- Article -->
  <section class="section" id="coverage">
    <div class="container article-grid">
      <div class="article-copy">
        <p class="eyebrow">For every trip</p>
        <h2>One point of contact while you travel</h2>
        <p>It's available for individuals, families, or teams travelling for business, and can be arranged alongside your other AG Cambodia policies for a single point of contact if anything happens while you're away.</p>
        <a href="#form" class="btn btn-gold">Get a free quote</a>
      </div>

      <aside class="peril-card">
        <h3>Travel insurance can cover</h3>
        <ul class="peril-list">
          <li>Emergency medical care abroad</li>
          <li>Medical evacuation</li>
          <li>Trip cancellation and interruption</li>
          <li>Baggage delay or loss</li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="section section-cream">
    <div class="container">
      <p class="eyebrow">Built for how you travel</p>
      <h2>Single trip or annual multi-trip</h2>
      <p class="section-lead">Individuals, families or teams travelling for business: choose the plan that matches how often you travel.</p>

      <div class="cov-grid cov-grid-2">
        <article class="cov-card">
          <span class="cov-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M3 12h18M12 3c2.5 2.5 3.5 6 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-6-3.5-9s1-6.5 3.5-9Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
          <span class="cov-tag">Single Trip</span>
          <h3>One trip</h3>
          <p>A holiday or a business trip? Get covered for the length of your trip, from cancellation to emergency medical care.</p>
          <a href="#form" class="link-arrow">Get a free quote <span aria-hidden="true">→</span></a>
        </article>
        <article class="cov-card">
          <span class="cov-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M17 3h4v4M21 3l-8 8M7 21H3v-4M3 21l8-8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
          <span class="cov-tag">Multi-Trip</span>
          <h3>Annual multi-trip</h3>
          <p>Travelling several times a year? An annual plan keeps you covered on every trip without arranging a new policy each time.</p>
          <a href="#form" class="link-arrow">Get a free quote <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </div>
  </section>

  <!-- Contact / Quote -->
  <section class="section quote-section" id="form">
    <div class="container quote-grid">
      <div class="quote-copy">
        <p class="eyebrow eyebrow-light">Get a quote</p>
        <h2>Your free travel insurance quote</h2>
        <p class="section-lead section-lead-light">Tell us about your trip. Compare offers from multiple insurers with clear, professional advice.</p>
        <ul class="check-list check-list-light">
          <li>We compare 15+ insurers to get you the best rate</li>
          <li>Available in French and English</li>
          <li>Officially licensed and registered in Cambodia</li>
          <li>Fully confidential — your request is never spammed</li>
        </ul>
        <div class="quote-cta-row">
          <a href="https://t.me/AGCambodia" class="btn btn-outline-light" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M21 4 3 11l6 2m12-9-4 16-8-6m0 0 3-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            Telegram
          </a>
          <a href="tel:+85523998018" class="btn btn-outline-light">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3.5c0-.6.4-1 1-1H7.7c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
            Call us
          </a>
        </div>
      </div>

      <div class="quote-form-card">
        <p class="quote-form-title">Company &amp; get covered</p>
        <p class="quote-form-sub">Tell us a bit about your trip and a broker will call you back within 24 hours.</p>

        <div class="quote-tabs" role="tablist" aria-label="Insurance type">
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Health Insurance</button>
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Vehicle</button>
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Property</button>
          <button type="button" class="quote-tab is-active" role="tab" aria-selected="true">Other</button>
        </div>

        <form id="quote-form" novalidate>
          <div class="form-row">
            <div class="form-field">
              <label for="firstName">First name *</label>
              <input id="firstName" name="firstName" type="text" required autocomplete="given-name" />
            </div>
            <div class="form-field">
              <label for="lastName">Last name *</label>
              <input id="lastName" name="lastName" type="text" required autocomplete="family-name" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-field">
              <label for="email">Email *</label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="form-field">
              <label for="phone">Phone / WhatsApp *</label>
              <input id="phone" name="phone" type="tel" required autocomplete="tel" />
            </div>
          </div>
          <div class="form-field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="4"></textarea>
          </div>
          <button type="submit" class="btn btn-gold btn-block">Request my free quote <span aria-hidden="true">→</span></button>
          <p class="form-note">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="5" y="11" width="14" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4" stroke="currentColor" stroke-width="1.5"></path></svg>
            Your information is 100% confidential
          </p>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

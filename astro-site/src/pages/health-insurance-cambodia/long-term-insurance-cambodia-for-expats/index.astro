---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en"
  title="Expat Health Insurance in Cambodia | AG Cambodia"
  description="Long-term international health insurance for expats in Cambodia. Compare APRIL, ACS and LUMA plans for quality care in Cambodia, the region and worldwide."
  quoteHref="/health-insurance-cambodia/long-term-insurance-cambodia-for-expats/form/"
>
  <!-- Page hero -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-grid">
        <div class="page-hero-copy">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <a href="/health-insurance-cambodia/">Health Insurance</a>
            <span aria-hidden="true">/</span>
            <span>Long-Term Insurance for Expats</span>
          </nav>
          <p class="eyebrow eyebrow-light">Health Insurance</p>
          <h1>International Health Insurance</h1>
          <p class="hero-lead">Whether you're working, retiring, or raising a family abroad, your health deserves global protection. AG Insurance Broker offers access to world-class insurers and flexible coverage tailored to your lifestyle — from essential hospitalization to full outpatient, maternity, and dental benefits.</p>
          <div class="hero-ctas">
            <a href="#why-choose" class="btn btn-outline-light">Read More</a>
            <a href="/health-insurance-cambodia/long-term-insurance-cambodia-for-expats/form/" class="btn btn-gold">Get a Quote</a>
          </div>
        </div>
        <div class="page-hero-visual">
          <img src="/assets/private-health-insurance.webp" alt="Doctor and nurse reviewing patient records on a tablet" width="600" height="400" />
        </div>
      </div>
    </div>
  </section>

  <!-- Why choose AG -->
  <section class="section" id="why-choose">
    <div class="container article-grid">
      <div class="article-copy">
        <p class="eyebrow">Why choose AG Insurance Broker?</p>
        <h2>Protection backed by A-rated insurers</h2>
        <p>AG Insurance Broker is a licensed broker and has partnered with only A-rated international insurers, offering guaranteed renewal policies and sustainable coverage that meets international standards. Our insurance plans provide direct payment to hospitals worldwide.</p>
        <p>We go through a multitude of fine print for you to compare plans adapted to your needs, and we're by your side during your stay abroad to provide emergency assistance and manage your policy. Unlike comparison websites, we're near you and respond to your requests in real time. Choose from Essential coverage limited to hospitalization costs, up to a Comprehensive plan including outpatient, maternity, and dental — according to your budget and needs.</p>
        <a href="/health-insurance-cambodia/long-term-insurance-cambodia-for-expats/form/" class="btn btn-gold">Get a Quote</a>
      </div>

      <aside class="peril-card">
        <h3>With AG Cambodia you ensure</h3>
        <ul class="peril-list">
          <li>Local emergency assistance</li>
          <li>Claim management &amp; refund within 15 days</li>
          <li>Advice and counseling to choose the right plan for you</li>
        </ul>
      </aside>
    </div>

    <div class="container">
      <div class="notice-box">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 2 3 6v6c0 5 3.8 8.7 9 10 5.2-1.3 9-5 9-10V6l-9-4Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        <p><strong>Repatriation included on every plan.</strong> All our plans include the repatriation (medical evacuation) option for severe and critical situations that can't be treated locally — a scenario that could easily cost over US$50,000 without proper insurance coverage.</p>
      </div>
    </div>
  </section>

  <!-- Plan tiers -->
  <section class="section section-cream">
    <div class="container">
      <p class="eyebrow">In other words&hellip;</p>
      <h2>Choose your level of coverage</h2>
      <p class="section-lead">Three tiers built around how you actually live and plan for the future — from essential hospital cover to full family protection.</p>

      <div class="plan-grid">
        <article class="plan-card">
          <h3>Hospitalization + Medevac</h3>
          <p class="plan-card-desc">Basic medical coverage for inpatient care and emergency evacuation.</p>
          <ul class="plan-features">
            <li class="is-included"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="m4 12 5 5L20 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>Inpatient care (hospital admission)</li>
            <li class="is-included"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="m4 12 5 5L20 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>Emergency surgery, room &amp; board, ICU</li>
            <li class="is-included"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="m4 12 5 5L20 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>Medevac to the nearest suitable facility</li>
            <li class="is-excluded"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>Outpatient treatments (visits, checkups, prescriptions)</li>
          </ul>
          <div class="plan-best-for">
            <strong>Best for</strong>
            <span>Young/healthy individuals, budget-conscious expats, or those with local outpatient options.</span>
          </div>
          <a href="/health-insurance-cambodia/long-term-insurance-cambodia-for-expats/form/" class="btn btn-gold btn-block">Get a Quote</a>
        </article>

        <article class="plan-card is-featured">
          <span class="plan-featured-tag">Most popular</span>
          <h3>Comprehensive + Medevac</h3>
          <p class="plan-card-desc">Broad protection for a full private healthcare experience — no surprises.</p>
          <ul class="plan-features">
            <li class="is-included"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="m4 12 5 5L20 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>Everything in Hospitalization + Medevac</li>
            <li class="is-included"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="m4 12 5 5L20 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>Outpatient care (GP visits, specialists, diagnostics, pharmacy)</li>
            <li class="is-included"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="m4 12 5 5L20 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>Some plans include mental health or physiotherapy</li>
          </ul>
          <div class="plan-best-for">
            <strong>Best for</strong>
            <span>Those who want a full private healthcare experience — no surprises.</span>
          </div>
          <a href="/health-insurance-cambodia/long-term-insurance-cambodia-for-expats/form/" class="btn btn-gold btn-block">Get a Quote</a>
        </article>

        <article class="plan-card">
          <h3>Comprehensive + Maternity + Medevac</h3>
          <p class="plan-card-desc">Full-spectrum coverage for individuals or couples planning a family.</p>
          <ul class="plan-features">
            <li class="is-included"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="m4 12 5 5L20 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>All benefits from Comprehensive + Medevac</li>
            <li class="is-included"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="m4 12 5 5L20 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>Pre/postnatal care</li>
            <li class="is-included"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="m4 12 5 5L20 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>Delivery (normal or cesarean)</li>
            <li class="is-included"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="m4 12 5 5L20 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>Sometimes newborn care and complications</li>
          </ul>
          <div class="plan-best-for">
            <strong>Best for</strong>
            <span>Couples or individuals planning a pregnancy in the next year or so.</span>
          </div>
          <a href="/health-insurance-cambodia/long-term-insurance-cambodia-for-expats/form/" class="btn btn-gold btn-block">Get a Quote</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Talk to our advisors -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">Need more information?</p>
      <h2>Talk to our health insurance advisors</h2>
      <p class="section-lead">Prefer to talk it through? Our local advisors — including Mark, Marie, and Sokchan — are on hand to walk you through the right plan for your situation.</p>
      <div class="hero-ctas">
        <a href="/health-insurance-cambodia/long-term-insurance-cambodia-for-expats/form/" class="btn btn-gold">Get a Quote</a>
        <a href="tel:+85523998018" class="btn btn-outline-dark">Call us</a>
      </div>
    </div>
  </section>

  <!-- Contact / Quote -->
  <section class="section quote-section" id="form">
    <div class="container quote-grid">
      <div class="quote-copy">
        <p class="eyebrow eyebrow-light">Get a quote</p>
        <h2>Your free health insurance quote within 24 hours</h2>
        <p class="section-lead section-lead-light">Tell us about your situation. Compare offers from multiple A-rated insurers with clear, professional advice.</p>
        <ul class="check-list check-list-light">
          <li>We compare 15+ insurers to get you the best rate</li>
          <li>Available in French and English</li>
          <li>Officially licensed and registered in Cambodia</li>
          <li>Fully confidential — your request is never spammed</li>
        </ul>
        <div class="quote-cta-row">
          <a href="https://t.me/AGCambodia" class="btn btn-outline-light" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M21 4 3 11l6 2m12-9-4 16-8-6m0 0 3-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            Telegram
          </a>
          <a href="tel:+85523998018" class="btn btn-outline-light">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3.5c0-.6.4-1 1-1H7.7c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
            Call us
          </a>
        </div>
      </div>

      <div class="quote-form-card">
        <p class="quote-form-title">Company &amp; get covered</p>
        <p class="quote-form-sub">Tell us a bit about your needs and a broker will call you back within 24 hours.</p>

        <div class="quote-tabs" role="tablist" aria-label="Insurance type">
          <button type="button" class="quote-tab is-active" role="tab" aria-selected="true">Health Insurance</button>
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Vehicle</button>
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Property</button>
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Other</button>
        </div>

        <form id="quote-form" novalidate>
          <div class="form-row">
            <div class="form-field">
              <label for="firstName">First name *</label>
              <input id="firstName" name="firstName" type="text" required autocomplete="given-name" />
            </div>
            <div class="form-field">
              <label for="lastName">Last name *</label>
              <input id="lastName" name="lastName" type="text" required autocomplete="family-name" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-field">
              <label for="email">Email *</label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="form-field">
              <label for="phone">Phone / WhatsApp *</label>
              <input id="phone" name="phone" type="tel" required autocomplete="tel" />
            </div>
          </div>
          <div class="form-field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="4"></textarea>
          </div>
          <button type="submit" class="btn btn-gold btn-block">Request my free quote <span aria-hidden="true">→</span></button>
          <p class="form-note">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="5" y="11" width="14" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4" stroke="currentColor" stroke-width="1.5"></path></svg>
            Your information is 100% confidential
          </p>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en"
  title="LUMA Expat Health Insurance | AG Cambodia"
  description="Comprehensive, customizable health insurance — designed for expats and families in Cambodia and across Asia."
  quoteHref="#form"
>
  <!-- Page hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/health-insurance-cambodia/">Health Insurance</a>
        <span aria-hidden="true">/</span>
        <a href="/health-insurance-cambodia/long-term-insurance-cambodia-for-expats/">Long-Term Insurance for Expats</a>
        <span aria-hidden="true">/</span>
        <span>LUMA</span>
      </nav>
      <p class="eyebrow eyebrow-light">Health Insurance Partner</p>
      <h1>LUMA Expat Health Insurance</h1>
      <p class="hero-lead">Comprehensive, customizable health insurance — designed for expats and families in Cambodia and across Asia.</p>
      <div class="hero-ctas">
        <a href="#form" class="btn btn-gold">Get a Quote</a>
        <a href="https://t.me/AGCambodia" class="btn btn-outline-light" target="_blank" rel="noopener">Chat with Marc</a>
      </div>
    </div>
  </section>

  <!-- Core coverage -->
  <section class="section">
    <div class="container article-grid">
      <div class="article-copy">
        <p class="eyebrow">Core coverage</p>
        <h2>Hospitalisation &amp; Medevac</h2>
        <ul class="check-list">
          <li>Inpatient and day-case hospitalisation</li>
          <li>Private room up to USD 170/day (Superior care and above cover true private rooms)</li>
          <li>Emergency evacuation &amp; repatriation worldwide (within zone)</li>
          <li>Direct billing with network hospitals, both inpatient and outpatient</li>
          <li>Locally applicable from Day 1</li>
        </ul>
      </div>
      <aside class="peril-card">
        <h3>Need more information about LUMA?</h3>
        <p>Chat with Marc, our LUMA specialist, for a tailored quote in minutes.</p>
        <a href="https://t.me/AGCambodia" class="btn btn-gold btn-block" target="_blank" rel="noopener">Chat with Marc</a>
      </aside>
    </div>
  </section>

  <!-- Optional modules -->
  <section class="section section-cream">
    <div class="container">
      <p class="eyebrow">Additional module options</p>
      <h2>Build the plan around you</h2>
      <ul class="check-list">
        <li>Outpatient &amp; routine health checks (GP visits, diagnostic tests)</li>
        <li>Dental &amp; Vision (check-ups, major dental work, glasses)</li>
        <li>Maternity (normal delivery and complications, with waiting period)</li>
      </ul>

      <h3>Coverage Zones &amp; Travel</h3>
      <ul class="check-list">
        <li><strong>Residence requirement:</strong> 185+ days/year in Cambodia</li>
        <li><strong>Area of cover:</strong> choose Zone A/B/C (Zone C is worldwide excluding major countries)</li>
        <li><strong>Emergency cover worldwide:</strong> up to 60-day trips outside zone, capped at USD 250,000/year</li>
      </ul>

      <h3>Deductibles &amp; Premium Adjustments</h3>
      <p>Optional deductibles available: USD 0, USD 500, USD 1,000, USD 6,000.</p>

      <h3>Digital Advantage &amp; Service</h3>
      <ul class="check-list">
        <li><strong>Age eligibility:</strong> 0–70 (must apply with parent if under 18)</li>
        <li><strong>Renewable for life</strong>, regardless of age or health condition</li>
        <li><strong>Free choice of hospital</strong>, wide direct-billing network</li>
        <li><strong>Digital support:</strong> mobile app, 24/7 member care, claim tracking</li>
      </ul>
    </div>
  </section>

  <!-- Contact / Quote -->
  <section class="section quote-section" id="form">
    <div class="container quote-grid">
      <div class="quote-copy">
        <p class="eyebrow eyebrow-light">Get a quote</p>
        <h2>Your free LUMA quote within 24 hours</h2>
        <p class="section-lead section-lead-light">Tell us about your situation. We'll help you pick the right zone, deductible and modules for your needs.</p>
        <ul class="check-list check-list-light">
          <li>We compare 15+ insurers to get you the best rate</li>
          <li>Available in French and English</li>
          <li>Officially licensed and registered in Cambodia</li>
          <li>Fully confidential — your request is never spammed</li>
        </ul>
        <div class="quote-cta-row">
          <a href="https://t.me/AGCambodia" class="btn btn-outline-light" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M21 4 3 11l6 2m12-9-4 16-8-6m0 0 3-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            Telegram
          </a>
          <a href="tel:+85523998018" class="btn btn-outline-light">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3.5c0-.6.4-1 1-1H7.7c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
            Call us
          </a>
        </div>
      </div>

      <div class="quote-form-card">
        <p class="quote-form-title">Company &amp; get covered</p>
        <p class="quote-form-sub">Tell us a bit about your needs and a broker will call you back within 24 hours.</p>

        <div class="quote-tabs" role="tablist" aria-label="Insurance type">
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Health Insurance</button>
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Vehicle</button>
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Property</button>
          <button type="button" class="quote-tab is-active" role="tab" aria-selected="true">Other</button>
        </div>

        <form id="quote-form" novalidate>
          <div class="form-row">
            <div class="form-field">
              <label for="firstName">First name *</label>
              <input id="firstName" name="firstName" type="text" required autocomplete="given-name" />
            </div>
            <div class="form-field">
              <label for="lastName">Last name *</label>
              <input id="lastName" name="lastName" type="text" required autocomplete="family-name" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-field">
              <label for="email">Email *</label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="form-field">
              <label for="phone">Phone / WhatsApp *</label>
              <input id="phone" name="phone" type="tel" required autocomplete="tel" />
            </div>
          </div>
          <div class="form-field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="4"></textarea>
          </div>
          <button type="submit" class="btn btn-gold btn-block">Request my free quote <span aria-hidden="true">→</span></button>
          <p class="form-note">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="5" y="11" width="14" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4" stroke="currentColor" stroke-width="1.5"></path></svg>
            Your information is 100% confidential
          </p>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

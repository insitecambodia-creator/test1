---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en"
  title="ACS Expat Health Insurance | AG Cambodia"
  description="ACS international health insurance for expats and long-term travellers in Cambodia: comprehensive worldwide cover, arranged and supported by AG Cambodia."
  quoteHref="#form"
>
  <!-- Page hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/health-insurance-cambodia/">Health Insurance</a>
        <span aria-hidden="true">/</span>
        <a href="/health-insurance-cambodia/long-term-insurance-cambodia-for-expats/">Long-Term Insurance for Expats</a>
        <span aria-hidden="true">/</span>
        <span>ACS</span>
      </nav>
      <p class="eyebrow eyebrow-light">Health Insurance Partner</p>
      <h1>ACS Expat Health Insurance</h1>
      <p class="hero-lead">Comprehensive international health coverage designed for expatriates and long-term travelers. Customize your protection with a modular approach that fits your lifestyle and your budget, starting with essential hospitalization and evacuation, then adding outpatient care, dental, maternity, and more as needed.</p>
      <div class="hero-ctas">
        <a href="#form" class="btn btn-gold">Get a Quote</a>
        <a href="https://t.me/AGCambodia" class="btn btn-outline-light" target="_blank" rel="noopener">Chat with Marc</a>
      </div>
    </div>
  </section>

  <!-- Core coverage -->
  <section class="section">
    <div class="container article-grid">
      <div class="article-copy">
        <p class="eyebrow">Core coverage</p>
        <h2>Hospitalisation &amp; Medevac</h2>
        <p>Every ACS Expat plan includes this essential module by default.</p>
        <ul class="check-list">
          <li>Coverage for hospital stays over 24 hours</li>
          <li>Surgical procedures, ICU, and prescribed treatments</li>
          <li>Private room (limit varies by plan level)</li>
          <li>Cancer treatment (limits depend on the plan)</li>
          <li>Psychiatric hospitalization (after a 3-month waiting period)</li>
          <li>Organ transplants (excluding donor and related medication costs)</li>
          <li>Medical evacuation to the nearest suitable medical center</li>
          <li>Return transport to your country of residence after treatment</li>
          <li>Rehabilitation, hospital-at-home, and local ambulance</li>
          <li>Emergency hospitalization while traveling outside your covered zone (short trips only)</li>
        </ul>
      </div>
      <aside class="peril-card">
        <h3>Need more information about ACS?</h3>
        <p>Chat with Marc, our ACS specialist, for a tailored quote in minutes.</p>
        <a href="https://t.me/AGCambodia" class="btn btn-gold btn-block" target="_blank" rel="noopener">Chat with Marc</a>
      </aside>
    </div>
  </section>

  <!-- Optional modules -->
  <section class="section section-cream">
    <div class="container">
      <p class="eyebrow">Optional modules</p>
      <h2>Build the plan around you</h2>

      <h3>Routine Medical Care (Outpatient)</h3>
      <p>Covers everyday healthcare needs like:</p>
      <ul class="check-list">
        <li>General practitioner and specialist visits</li>
        <li>Laboratory tests, scans, and MRIs</li>
        <li>Prescription medication and vaccines</li>
        <li>Physiotherapy and alternative medicine (e.g., acupuncture)</li>
        <li>Cancer screening and general health checkups</li>
        <li>Self-medication and smoking cessation (Level 2+)</li>
      </ul>
      <p>Levels available: Level 1 (basic outpatient care), Level 2 (extended coverage), Level 3 (comprehensive, Platinum-only).</p>

      <h3>Dental &amp; Optical</h3>
      <p>Available only if you subscribe to outpatient care.</p>
      <ul class="check-list">
        <li>Dental cleanings, fillings, extractions, root canals</li>
        <li>Dental prosthetics (inlays, crowns, implants)</li>
        <li>Orthodontics (children under 16)</li>
        <li>Prescription glasses and contact lenses</li>
        <li>Laser vision correction</li>
      </ul>
      <p>Two levels: Level 1 up to $2,000/year, Level 2 up to $4,000/year.</p>

      <h3>Maternity</h3>
      <p>Requires outpatient module. 12-month waiting period.</p>
      <ul class="check-list">
        <li>Pre- and post-natal consultations</li>
        <li>Hospital delivery and private room</li>
        <li>Caesarean section (if medically required)</li>
        <li>Childbirth preparation</li>
        <li>Newborn screening and care</li>
        <li>Medically Assisted Reproduction (Level 2 only, 18-month wait)</li>
      </ul>
      <p>Two levels: Level 1 up to $6,000/pregnancy, Level 2 up to $12,000/pregnancy.</p>

      <h3>Assistance Plus</h3>
      <p>Extra support benefits for real-life emergencies:</p>
      <ul class="check-list">
        <li>Hotel costs post-Medevac ($80/night, up to 10 nights)</li>
        <li>Childcare during hospitalization</li>
        <li>Early return tickets in case of family emergency</li>
        <li>Repatriation of family members</li>
        <li>Legal support and psychological assistance</li>
        <li>Funeral expenses and body transport</li>
        <li>Search and rescue costs</li>
      </ul>
    </div>
  </section>

  <!-- Contact / Quote -->
  <section class="section quote-section" id="form">
    <div class="container quote-grid">
      <div class="quote-copy">
        <p class="eyebrow eyebrow-light">Get a quote</p>
        <h2>Your free ACS quote within 24 hours</h2>
        <p class="section-lead section-lead-light">Tell us about your situation. We'll help you pick the right modules and levels for your needs.</p>
        <ul class="check-list check-list-light">
          <li>We compare 15+ insurers to get you the best rate</li>
          <li>Available in French and English</li>
          <li>Officially licensed and registered in Cambodia</li>
          <li>Fully confidential: your request is never spammed</li>
        </ul>
        <div class="quote-cta-row">
          <a href="https://t.me/AGCambodia" class="btn btn-outline-light" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M21 4 3 11l6 2m12-9-4 16-8-6m0 0 3-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            Telegram
          </a>
          <a href="tel:+85523998018" class="btn btn-outline-light">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3.5c0-.6.4-1 1-1H7.7c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
            Call us
          </a>
        </div>
      </div>

      <div class="quote-form-card">
        <p class="quote-form-title">Company &amp; get covered</p>
        <p class="quote-form-sub">Tell us a bit about your needs and a broker will call you back within 24 hours.</p>

        <div class="quote-tabs" role="tablist" aria-label="Insurance type">
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Health Insurance</button>
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Vehicle</button>
          <button type="button" class="quote-tab" role="tab" aria-selected="false">Property</button>
          <button type="button" class="quote-tab is-active" role="tab" aria-selected="true">Other</button>
        </div>

        <form id="quote-form" novalidate>
          <div class="form-row">
            <div class="form-field">
              <label for="firstName">First name *</label>
              <input id="firstName" name="firstName" type="text" required autocomplete="given-name" />
            </div>
            <div class="form-field">
              <label for="lastName">Last name *</label>
              <input id="lastName" name="lastName" type="text" required autocomplete="family-name" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-field">
              <label for="email">Email *</label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="form-field">
              <label for="phone">Phone / WhatsApp *</label>
              <input id="phone" name="phone" type="tel" required autocomplete="tel" />
            </div>
          </div>
          <div class="form-field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="4"></textarea>
          </div>
          <button type="submit" class="btn btn-gold btn-block">Request my free quote <span aria-hidden="true">→</span></button>
          <p class="form-note">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="5" y="11" width="14" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4" stroke="currentColor" stroke-width="1.5"></path></svg>
            Your information is 100% confidential
          </p>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

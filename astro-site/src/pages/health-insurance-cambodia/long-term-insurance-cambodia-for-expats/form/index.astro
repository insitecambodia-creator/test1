---
import QuizLayout from '../../../../layouts/QuizLayout.astro';

const backHref = '/health-insurance-cambodia/long-term-insurance-cambodia-for-expats/';
---

<QuizLayout
  lang="en"
  title="Tell Us About Your Health Insurance Needs | AG Insurance Broker"
  description="A few quick questions to help us match you with the right international health insurance plan in Cambodia."
  backHref={backHref}
  skipToContent="Skip to content"
  closeLabel="Close and return to the health insurance page"
>
  <!-- Multi-step questionnaire -->
  <section class="quiz-wrap">
    <div class="container">

      <div class="quiz-card">
        <div class="quiz-progress-track"><div class="quiz-progress-fill" id="quiz-progress-fill"></div></div>
        <span class="quiz-progress-label" id="quiz-progress-label">Step 1 of 8</span>

        <form id="quiz-form">

          <!-- Carried over from the short form on the rest of the site, via
               URL query params (?firstName=&lastName=&email=&phone=). See
               the prefill script at the bottom of this page. -->
          <input type="hidden" name="firstName" id="hidden-firstName" />
          <input type="hidden" name="lastName" id="hidden-lastName" />
          <input type="hidden" name="email" id="hidden-email" />
          <input type="hidden" name="phone" id="hidden-phone" />

          <!-- Step 1 — About Yourself -->
          <div class="quiz-step is-active" data-step="1">
            <p class="quiz-greeting" id="quiz-greeting"></p>
            <p class="quiz-step-eyebrow">About yourself</p>
            <h2>A little about you</h2>
            <div class="quiz-field">
              <label for="q-nationality">Country of nationality</label>
              <select id="q-nationality" name="nationality">
                <option value="">Select a country</option>
                <option>France</option>
                <option>United States</option>
                <option>United Kingdom</option>
                <option>Australia</option>
                <option>Canada</option>
                <option>Germany</option>
                <option>Cambodia</option>
                <option>Singapore</option>
                <option>Other</option>
              </select>
            </div>
            <div class="quiz-field">
              <label for="q-residence">Country of residence</label>
              <select id="q-residence" name="residence">
                <option value="Cambodia" selected>Cambodia</option>
                <option>Thailand</option>
                <option>Vietnam</option>
                <option>Other</option>
              </select>
            </div>
            <div class="quiz-field">
              <label for="q-city">City</label>
              <select id="q-city" name="city">
                <option value="">Select a city</option>
                <option>Phnom Penh</option>
                <option>Siem Reap</option>
                <option>Kampot</option>
                <option>Battambang</option>
                <option>Other</option>
              </select>
            </div>
            <div class="quiz-field">
              <label for="q-dob">Date of birth (or age)</label>
              <input type="text" id="q-dob" name="dob" placeholder="e.g. 14/06/1985 or 40" />
            </div>
          </div>

          <!-- Step 2 — Who needs cover -->
          <div class="quiz-step" data-step="2">
            <p class="quiz-step-eyebrow">Who needs cover?</p>
            <h2>Who are we covering?</h2>
            <div class="option-list" data-option-group="who">
              <label class="option-pill"><input type="radio" name="who" value="myself" /><span>Just myself</span></label>
              <label class="option-pill"><input type="radio" name="who" value="spouse" /><span>Myself + spouse</span></label>
              <label class="option-pill"><input type="radio" name="who" value="family" /><span>Family</span></label>
              <label class="option-pill"><input type="radio" name="who" value="children" /><span>Children only</span></label>
            </div>

            <div class="quiz-conditional" id="spouse-block">
              <div class="quiz-field">
                <label for="q-spouse-dob">Spouse's date of birth (or age)</label>
                <input type="text" id="q-spouse-dob" name="spouseDob" placeholder="e.g. 14/06/1987 or 38" />
              </div>
            </div>

            <div class="quiz-conditional" id="family-members-block">
              <p class="quiz-step-hint" style="margin-top:18px;">Add each family member you'd like covered.</p>
              <div id="family-members-list"></div>
              <button type="button" class="btn-add-member" id="add-family-member">+ Add family member</button>
            </div>
          </div>

          <!-- Step 3 — When -->
          <div class="quiz-step" data-step="3">
            <p class="quiz-step-eyebrow">Timing</p>
            <h2>When do you need insurance?</h2>
            <div class="option-list">
              <label class="option-pill"><input type="radio" name="timing" value="immediately" /><span>Immediately</span></label>
              <label class="option-pill"><input type="radio" name="timing" value="30days" /><span>Within 30 days</span></label>
              <label class="option-pill"><input type="radio" name="timing" value="1to3months" /><span>In 1&ndash;3 months</span></label>
              <label class="option-pill"><input type="radio" name="timing" value="comparing" /><span>Just comparing options</span></label>
            </div>
          </div>

          <!-- Step 4 — Current insurance -->
          <div class="quiz-step" data-step="4">
            <p class="quiz-step-eyebrow">Current insurance</p>
            <h2>Do you currently have health insurance?</h2>
            <div class="option-list" data-option-group="current-insurance">
              <label class="option-pill"><input type="radio" name="hasCurrentInsurance" value="yes" /><span>Yes</span></label>
              <label class="option-pill"><input type="radio" name="hasCurrentInsurance" value="no" /><span>No</span></label>
            </div>
            <div class="quiz-conditional" id="current-insurance-block">
              <div class="quiz-field">
                <label for="q-current-insurer">Current insurer</label>
                <input type="text" id="q-current-insurer" name="currentInsurer" />
              </div>
              <div class="quiz-field">
                <label for="q-renewal-date">Renewal date</label>
                <input type="text" id="q-renewal-date" name="renewalDate" placeholder="e.g. March 2027" />
              </div>
            </div>
          </div>

          <!-- Step 5 — Where covered -->
          <div class="quiz-step" data-step="5">
            <p class="quiz-step-eyebrow">Coverage area</p>
            <h2>Where do you want to be covered?</h2>
            <p class="quiz-step-hint">This is probably the most important question.</p>
            <div class="option-list">
              <label class="option-pill"><input type="radio" name="coverageArea" value="cambodia" /><span>Cambodia only</span></label>
              <label class="option-pill"><input type="radio" name="coverageArea" value="sea" /><span>Southeast Asia</span></label>
              <label class="option-pill"><input type="radio" name="coverageArea" value="worldwide-ex-usa" /><span>Worldwide excluding USA</span></label>
              <label class="option-pill"><input type="radio" name="coverageArea" value="worldwide-inc-usa" /><span>Worldwide including USA</span></label>
            </div>
          </div>

          <!-- Step 6 — Benefits -->
          <div class="quiz-step" data-step="6">
            <p class="quiz-step-eyebrow">Benefits</p>
            <h2>Which level of benefits do you need?</h2>
            <div class="option-list">
              <label class="option-pill"><input type="radio" name="benefitsTier" value="hospitalisation" /><span>Hospitalisation</span></label>
              <label class="option-pill"><input type="radio" name="benefitsTier" value="hosp-outpatient" /><span>Hospitalisation + Outpatient</span></label>
              <label class="option-pill"><input type="radio" name="benefitsTier" value="hosp-outpatient-maternity" /><span>Hospitalisation + Outpatient + Maternity</span></label>
              <label class="option-pill"><input type="radio" name="benefitsTier" value="hosp-outpatient-maternity-dental-vision" /><span>Hospitalisation + Outpatient + Maternity + Dental + Vision</span></label>
            </div>
          </div>

          <!-- Step 7 — Medical questions -->
          <div class="quiz-step" data-step="7">
            <p class="quiz-step-eyebrow">Medical questions</p>
            <h2>Have you been diagnosed or treated in the past 5 years for:</h2>
            <div class="option-list" data-option-group="medical">
              <label class="option-pill"><input type="checkbox" name="medical" value="diabetes" /><span>Diabetes</span></label>
              <label class="option-pill"><input type="checkbox" name="medical" value="heart" /><span>Heart disease</span></label>
              <label class="option-pill"><input type="checkbox" name="medical" value="cancer" /><span>Cancer</span></label>
              <label class="option-pill"><input type="checkbox" name="medical" value="bloodpressure" /><span>High blood pressure</span></label>
              <label class="option-pill"><input type="checkbox" name="medical" value="asthma" /><span>Asthma</span></label>
              <label class="option-pill"><input type="checkbox" name="medical" value="none" id="medical-none" /><span>None of the above</span></label>
              <label class="option-pill"><input type="checkbox" name="medical" value="prefer-not-to-say" id="medical-prefer-not" /><span>Prefer not to say for now</span></label>
            </div>
          </div>

          <!-- Step 8 — How did you hear about us -->
          <div class="quiz-step" data-step="8">
            <p class="quiz-step-eyebrow">Last step</p>
            <h2>How did you hear about us?</h2>
            <div class="quiz-field">
              <label for="q-source">Select an option</label>
              <select id="q-source" name="source">
                <option value="">Select an option</option>
                <option>Google search</option>
                <option>Facebook</option>
                <option>LinkedIn</option>
                <option>Referral from a friend/colleague</option>
                <option>Already a client</option>
                <option>Other</option>
              </select>
            </div>
          </div>

          <!-- Done state -->
          <div class="quiz-step" data-step="done">
            <div class="quiz-done">
              <svg width="52" height="52" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.6"></circle><path d="M8 12.5l2.5 2.5L16 9.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              <h2>Thanks — that's everything!</h2>
              <p>A broker will review your answers and get back to you within 24 hours with tailored options.</p>
            </div>
          </div>

          <p class="quiz-submit-error" id="quiz-submit-error" role="alert" hidden>Sorry, we couldn't send your answers. Please check your connection and try again.</p>

          <div class="quiz-nav" id="quiz-nav">
            <button type="button" class="btn btn-outline-dark" id="quiz-back">Back</button>
            <span class="quiz-nav-spacer"></span>
            <button type="button" class="btn btn-gold" id="quiz-next">Next</button>
          </div>

        </form>
      </div>

    </div>
  </section>
</QuizLayout>

<script>
  import { submitHealthForm } from '../../../../scripts/health-form-submit.js';

  (function () {
    var steps = Array.prototype.slice.call(document.querySelectorAll('.quiz-step'));
    var totalSteps = steps.length - 1; // exclude the "done" step from the count
    var currentIndex = 0; // index into steps[]

    var progressFill = document.getElementById('quiz-progress-fill');
    var progressLabel = document.getElementById('quiz-progress-label');
    var backBtn = document.getElementById('quiz-back');
    var nextBtn = document.getElementById('quiz-next');
    var navRow = document.getElementById('quiz-nav');

    function renderStep() {
      steps.forEach(function (el, i) { el.classList.toggle('is-active', i === currentIndex); });

      var isDone = steps[currentIndex].dataset.step === 'done';
      backBtn.style.visibility = (currentIndex === 0 || isDone) ? 'hidden' : 'visible';
      navRow.style.display = isDone ? 'none' : 'flex';

      var stepNum = Math.min(currentIndex + 1, totalSteps);
      progressFill.style.width = (stepNum / totalSteps * 100) + '%';
      progressLabel.textContent = 'Step ' + stepNum + ' of ' + totalSteps;

      nextBtn.textContent = (currentIndex === totalSteps - 1) ? 'Submit' : 'Next';

      document.querySelector('.quiz-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    var form = document.getElementById('quiz-form');
    var submitError = document.getElementById('quiz-submit-error');
    var submitting = false;

    nextBtn.addEventListener('click', function () {
      if (submitting) return;
      // Last question: send the answers to n8n, then show the thank-you step.
      if (currentIndex === totalSteps - 1) {
        submitting = true;
        submitError.hidden = true;
        var nextLabel = nextBtn.textContent;
        nextBtn.disabled = true;
        nextBtn.textContent = 'Sending…';
        submitHealthForm(form, 'en').then(function () {
          currentIndex++;
          renderStep();
        }).catch(function () {
          submitError.hidden = false;
          nextBtn.textContent = nextLabel;
        }).finally(function () {
          submitting = false;
          nextBtn.disabled = false;
        });
        return;
      }
      if (currentIndex < steps.length - 1) {
        currentIndex++;
        renderStep();
      }
    });
    backBtn.addEventListener('click', function () {
      if (currentIndex > 0) {
        currentIndex--;
        renderStep();
      }
    });

    // Selectable pill highlighting
    document.querySelectorAll('.option-pill input').forEach(function (input) {
      input.addEventListener('change', function () {
        if (input.type === 'radio') {
          document.querySelectorAll('input[name="' + input.name + '"]').forEach(function (sibling) {
            sibling.closest('.option-pill').classList.toggle('is-selected', sibling.checked);
          });
        } else {
          input.closest('.option-pill').classList.toggle('is-selected', input.checked);
        }
      });
    });

    // Conditional: Who needs cover -> Family members / Spouse DOB
    var familyBlock = document.getElementById('family-members-block');
    var familyList = document.getElementById('family-members-list');
    var addFamilyBtn = document.getElementById('add-family-member');
    var spouseBlock = document.getElementById('spouse-block');
    var familyCount = 0;

    function addFamilyMember() {
      familyCount++;
      var row = document.createElement('div');
      row.className = 'family-member';
      row.innerHTML =
        '<button type="button" class="family-member-remove" aria-label="Remove">&times;</button>' +
        '<div class="quiz-field"><label>Name</label><input type="text" name="familyName' + familyCount + '"></div>' +
        '<div class="quiz-row">' +
          '<div class="quiz-field"><label>Date of birth</label><input type="text" name="familyDob' + familyCount + '" placeholder="e.g. 14/06/2010"></div>' +
          '<div class="quiz-field"><label>Relationship</label><input type="text" name="familyRelationship' + familyCount + '" placeholder="e.g. Spouse, Child"></div>' +
        '</div>';
      row.querySelector('.family-member-remove').addEventListener('click', function () { row.remove(); });
      familyList.appendChild(row);
    }

    document.querySelectorAll('input[name="who"]').forEach(function (radio) {
      radio.addEventListener('change', function () {
        if (!radio.checked) return;

        familyBlock.classList.toggle('is-visible', radio.value === 'family');
        if (radio.value === 'family' && familyList.children.length === 0) addFamilyMember();

        spouseBlock.classList.toggle('is-visible', radio.value === 'spouse');
      });
    });
    addFamilyBtn.addEventListener('click', addFamilyMember);

    // Conditional: current insurance yes -> show insurer/renewal fields
    var currentInsuranceBlock = document.getElementById('current-insurance-block');
    document.querySelectorAll('input[name="hasCurrentInsurance"]').forEach(function (radio) {
      radio.addEventListener('change', function () {
        currentInsuranceBlock.classList.toggle('is-visible', radio.value === 'yes' && radio.checked);
      });
    });

    // Medical checkboxes: "None of the above" and "Prefer not to say" are
    // mutually exclusive with the specific conditions, and with each other.
    var medicalExclusive = [document.getElementById('medical-none'), document.getElementById('medical-prefer-not')];
    var medicalOthers = Array.prototype.slice.call(document.querySelectorAll('input[name="medical"]'))
      .filter(function (el) { return medicalExclusive.indexOf(el) === -1; });

    medicalExclusive.forEach(function (exclusiveEl) {
      exclusiveEl.addEventListener('change', function () {
        if (exclusiveEl.checked) {
          medicalOthers.forEach(function (el) {
            el.checked = false;
            el.closest('.option-pill').classList.remove('is-selected');
            el.closest('.option-pill').classList.add('is-disabled');
          });
          medicalExclusive.forEach(function (other) {
            if (other !== exclusiveEl) {
              other.checked = false;
              other.closest('.option-pill').classList.remove('is-selected');
            }
          });
        } else {
          medicalOthers.forEach(function (el) { el.closest('.option-pill').classList.remove('is-disabled'); });
        }
      });
    });
    medicalOthers.forEach(function (el) {
      el.addEventListener('change', function () {
        if (el.checked) {
          medicalExclusive.forEach(function (exclusiveEl) {
            exclusiveEl.checked = false;
            exclusiveEl.closest('.option-pill').classList.remove('is-selected');
          });
        }
      });
    });

    // Carry over name/email/phone handed off from the short form elsewhere
    // on the site (?firstName=&lastName=&email=&phone=), so the person
    // doesn't have to retype what they already gave us.
    var params = new URLSearchParams(window.location.search);
    ['firstName', 'lastName', 'email', 'phone'].forEach(function (key) {
      var value = params.get(key);
      if (value) {
        var hidden = document.getElementById('hidden-' + key);
        if (hidden) hidden.value = value;
      }
    });
    var firstName = params.get('firstName');
    if (firstName) {
      var greetingEl = document.getElementById('quiz-greeting');
      greetingEl.textContent = 'Welcome back, ' + firstName + '.';
      greetingEl.classList.add('is-visible');
    }

    renderStep();
  })();
</script>
